# ============================================================
# MerchantMind environment configuration
# Copy to .env and adjust as needed. NEVER commit .env.
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=merchantmind
POSTGRES_PASSWORD=merchantmind
POSTGRES_DB=merchantmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Used by the FastAPI backend (psycopg v3 driver).
# Inside docker-compose this is overridden to point at host "db".
DATABASE_URL=postgresql+psycopg://merchantmind:merchantmind@localhost:5432/merchantmind

# ---------- Backend ----------
APP_ENV=local
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---------- LLM (optional generative model; keep LLM_PROVIDER=local to use deterministic rules) ----------
# Works with any OpenAI-compatible endpoint: DeepSeek / Qwen DashScope / Volcengine Ark / OpenAI / vLLM.
# DeepSeek example (recommended):
LLM_PROVIDER=local
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# Qwen compatible mode: LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1, LLM_MODEL=qwen-plus
# OpenAI: LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=gpt-4o-mini

# ---------- Knowledge semantic layer (embedding & matching are both selectable) ----------
# Embedding provider: local(hash,256,default) | bge(local pretrained BGE ONNX,512) | openai(online)
KNOWLEDGE_EMBEDDING_PROVIDER=local
# Retrieval strategy: vector(pgvector cosine,default) | bm25(lexical) | hybrid(RRF fusion)
KNOWLEDGE_RETRIEVAL_STRATEGY=vector
# Online embedding model used when KNOWLEDGE_EMBEDDING_PROVIDER=openai (reuses LLM_BASE_URL / LLM_API_KEY)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Intent classifier ----------
# rule(default, keeps evaluation reproducible) | ml(TF-IDF + softmax) | dnn(frozen BGE + MLP head) | hybrid
INTENT_CLASSIFIER_BACKEND=rule

# ---------- Observability (optional; fallback = PostgreSQL local trace) ----------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
